&dns
ng(1:3) = 1, 32, 32
l(1:3)  = 0.125, 4., 4.
gtype = 1, gr = 0.
cfl = 0.5, dtmax = 1.e9, dt_f = -1.
is_solve_ns = T, is_track_interface = T
inivel = 'zer'
is_wallturb = F, is_forced_hit = F
nstep = 100, time_max = 100., tw_max = 0.1
stop_type(1:3) = T, F, F
restart = F, is_overwrite_save = T, nsaves_max = 0
icheck = 100, iout0d = 100, iout1d = 0, iout2d = 0, iout3d = 0, isave = 100
tout0d = 0., tout1d = 0., tout2d = 0., tout3d = 0., tsave = 0.
cbcvel(0:1,1:3,1) = 'P','P',  'N','N',  'D','D'
cbcvel(0:1,1:3,2) = 'P','P',  'D','D',  'D','D'
cbcvel(0:1,1:3,3) = 'P','P',  'N','N',  'D','D'
cbcpre(0:1,1:3)   = 'P','P',  'N','N',  'N','N'
bcvel(0:1,1:3,1) =  0.,0.,   0.,0.,   0.,0.
bcvel(0:1,1:3,2) =  0.,0.,   0.,0.,   0.,0.
bcvel(0:1,1:3,3) =  0.,0.,   0.,0.,   0.,0.
bcpre(0:1,1:3)   =  0.,0.,   0.,0.,   0.,0.
bforce(1:3) = 0., 0., 0.
gacc(1:3) = 0., 0., 0.
nscal = 1
dims(1:2) = 1, 4
/

&scalar
iniscal(1)         = 'cou'
cbcscal(0:1,1:3,1) = 'P','P',  'N','N',  'D','D'
bcscal(0:1,1:3,1)  =  0.,0.,   0.,0.,   0.,4.
ssource(1)         = 0.
/

&two_fluid
ifc_reconstruction = 'plic'
nmarker = 2
inipsi            = 'drp2-x'
cbcpsi(0:1,1:3)   = 'P','P',  'N','N',  'N','N'
bcpsi(0:1,1:3)    =  0.,0.,   0.,0.,   0.,0.
rho12(1:2)        =  0.5, 1.
mu12(1:2)         =  0.694444444444444, 1.388888888888889
sigma             =  24.11265432098765
dsigma_ds         = -1.388888888888889
s_ref             =  2.
ka12(1:2,1)       =  0.694444444444444, 1.388888888888889
cp12(1:2,1)       =  0.5, 1.
beta12(1:2)       =  0., 0.
/

&cudecomp
cudecomp_t_comm_backend = 0, cudecomp_is_t_enable_nccl = T, cudecomp_is_t_enable_nvshmem = T
cudecomp_h_comm_backend = 0, cudecomp_is_h_enable_nccl = T, cudecomp_is_h_enable_nvshmem = T
/
