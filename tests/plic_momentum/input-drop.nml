&dns
ng(1:3) = 64, 2, 64
l(1:3)  = 1., 0.03125, 1.
gtype = 1, gr = 0.
cfl = 0.95, dtmax = 1.e9, dt_f = 0.00390625
is_solve_ns = T, is_track_interface = T
inivel = 'dia'
is_wallturb = F, is_forced_hit = F
nstep = 256, time_max = 100., tw_max = 0.1
stop_type(1:3) = T, F, F
restart = F, is_overwrite_save = T, nsaves_max = 0
icheck = 10, iout0d = 32, iout1d = 0, iout2d = 0, iout3d = 256, isave = 0
cbcvel(0:1,1:3,1) = 'P','P',  'P','P',  'P','P'
cbcvel(0:1,1:3,2) = 'P','P',  'P','P',  'P','P'
cbcvel(0:1,1:3,3) = 'P','P',  'P','P',  'P','P'
cbcpre(0:1,1:3)   = 'P','P',  'P','P',  'P','P'
bcvel(0:1,1:3,1) =  0.,0.,   0.,0.,   0.,0.
bcvel(0:1,1:3,2) =  0.,0.,   0.,0.,   0.,0.
bcvel(0:1,1:3,3) =  0.,0.,   0.,0.,   0.,0.
bcpre(0:1,1:3)   =  0.,0.,   0.,0.,   0.,0.
bforce(1:3) = 0., 0., 0.
gacc(1:3) = 0., 0., 0.
nscal = 1
dims(1:2) = 2, 2, ipencil_axis = 2
/

&scalar
iniscal(1)         = 'uni'
cbcscal(0:1,1:3,1) = 'P','P',  'P','P',  'P','P'
bcscal(0:1,1:3,1)  =  0.,0.,   0.,0.,   1.,1.
ssource(1)         = 0.
is_boussinesq_buoyancy = T
/

&two_fluid
ifc_reconstruction = 'plic'
ifc_transport      = 'sweeps'
inipsi            = 'drp2'
cbcpsi(0:1,1:3)   = 'P','P',  'P','P',  'P','P'
bcpsi(0:1,1:3)    =  0.,0.,   0.,0.,   0.,0.
rho12(1:2)        =  1000., 0.001
mu12(1:2)         =  0., 0.
sigma             =  0.
ka12(1:2,1)       =  0., 0.
cp12(1:2,1)       =  1., 1.
beta12(1:2)       =  0., 0.
psi_thickness_factor = 0.51
/

&cudecomp
cudecomp_t_comm_backend = 0, cudecomp_is_t_enable_nccl = T, cudecomp_is_t_enable_nvshmem = T
cudecomp_h_comm_backend = 0, cudecomp_is_h_enable_nccl = T, cudecomp_is_h_enable_nvshmem = T
/
