&dns
ng(1:3) = 1, 64, 64
l(1:3)  = 0.015625, 1., 1.
gtype = 1, gr = 0.
cfl = 0.95, dtmax = 1., dt_f = 0.00390625
is_solve_ns = F, is_track_interface = T
inivel = 'vor-x'
is_wallturb = F, is_forced_hit = F
nstep = 1024, time_max = 100., tw_max = 0.1
stop_type(1:3) = T, F, F
restart = F, is_overwrite_save = T, nsaves_max = 0
icheck = 64, iout0d = 64, iout1d = 0, iout2d = 0, iout3d = 1024, isave = 0
cbcvel(0:1,1:3,1) = 'P','P',  'D','D',  'D','D'
cbcvel(0:1,1:3,2) = 'P','P',  'D','D',  'D','D'
cbcvel(0:1,1:3,3) = 'P','P',  'D','D',  'D','D'
cbcpre(0:1,1:3)   = 'P','P',  'N','N',  'N','N'
bcvel(0:1,1:3,1) =  0.,0.,   0.,0.,   0.,0.
bcvel(0:1,1:3,2) =  0.,0.,   0.,0.,   0.,0.
bcvel(0:1,1:3,3) =  0.,0.,   0.,0.,   0.,0.
bcpre(0:1,1:3)   =  0.,0.,   0.,0.,   0.,0.
bforce(1:3) = 0., 0., 0.
gacc(1:3) = 0., 0., 0.
dims(1:2) = 1, 4
/

&scalar
iniscal(1)         = 'zer'
cbcscal(0:1,1:3,1) = 'P','P',  'N','N',  'N','N'
bcscal(0:1,1:3,1)  =  0.,0.,   0.,0.,   0.,0.
ssource(1)         = 0.
/

&two_fluid
ifc_reconstruction = 'thinc'
ifc_advection      = 'split'
inipsi            = 'bub2-x'
cbcpsi(0:1,1:3)   = 'P','P',  'N','N',  'N','N'
bcpsi(0:1,1:3)    =  0.,0.,   0.,0.,   0.,0.
rho12(1:2)        =  1., 1.
mu12(1:2)         =  100., 100.
sigma             =  1.
ka12(1:2,1)       =  0., 0.
cp12(1:2,1)       =  0., 0.
beta12(1:2)       =  0., 0.
psi_thickness_factor = 0.51
/

&cudecomp
cudecomp_t_comm_backend = 0, cudecomp_is_t_enable_nccl = T, cudecomp_is_t_enable_nvshmem = T
cudecomp_h_comm_backend = 0, cudecomp_is_h_enable_nccl = T, cudecomp_is_h_enable_nvshmem = T
/
