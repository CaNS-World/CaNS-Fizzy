&dns
ng(1:3) = 1, 32, 32
l(1:3)  = 0.03125, 1., 1.
gtype = 1, gr = 0.
cfl = 0.5, dtmax = 1.e9, dt_f = -1.
is_solve_ns = T, is_track_interface = T
inivel = 'zer'
is_wallturb = F, is_forced_hit = F
nstep = 100000000, time_max = 0.3, tw_max = 0.1
stop_type(1:3) = F, T, F
restart = F, is_overwrite_save = T, nsaves_max = 0
icheck = 20, iout0d = 100, iout1d = 100000000, iout2d = 100000000, iout3d = 100000000, isave = 100000000
cbcvel(0:1,1:3,1) = 'P','P',  'P','P',  'D','D'
cbcvel(0:1,1:3,2) = 'P','P',  'P','P',  'D','D'
cbcvel(0:1,1:3,3) = 'P','P',  'P','P',  'D','D'
cbcpre(0:1,1:3)   = 'P','P',  'P','P',  'N','N'
bcvel(0:1,1:3,1) =  0.,0.,   0.,0.,   0.,0.
bcvel(0:1,1:3,2) =  0.,0.,   0.,0.,   0.,0.
bcvel(0:1,1:3,3) =  0.,0.,   0.,0.,   0.,0.
bcpre(0:1,1:3)   =  0.,0.,   0.,0.,   0.,0.
bforce(1:3) = 0., 0., 0.
gacc(1:3) = 0., 0., 0.
nscal = 1
dims(1:2) = 1, 2
/

&scalar
iniscal(1)         = 'cos-x'
cbcscal(0:1,1:3,1) = 'P','P',  'P','P',  'N','N'
bcscal(0:1,1:3,1)  =  0.,0.,   0.,0.,   0.,0.
ssource(1)         = 0.
/

&two_fluid
inipsi            = 'flm'
cbcpsi(0:1,1:3)   = 'P','P',  'P','P',  'N','N'
bcpsi(0:1,1:3)    =  0.,0.,   0.,0.,   0.,0.
rho12(1:2)        =  1., 1.
mu12(1:2)         =  1.0, 1.0
sigma             =  1.
dsigma_ds         =  0.01
s_ref             =  0.
ka12(1:2,1)       =  0., 0.
cp12(1:2,1)       =  1., 1.
beta12(1:2)       =  0., 0.
/

&cudecomp
cudecomp_t_comm_backend = 0, cudecomp_is_t_enable_nccl = T, cudecomp_is_t_enable_nvshmem = T
cudecomp_h_comm_backend = 0, cudecomp_is_h_enable_nccl = T, cudecomp_is_h_enable_nvshmem = T
/
